# Paddle Environment Configuration
# Set to 'production' for live, or 'sandbox' for testing
NEXT_PUBLIC_PADDLE_ENV=sandbox

# Client-side API token from Paddle Developer Tools > Authentication
# Must start with 'test_' for sandbox, or 'live_' for production
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_your_client_token_here

# Paddle Price IDs for the 3 pricing tiers
NEXT_PUBLIC_PADDLE_PRICE_STARTER_MONTH=pri_starter_monthly_id
NEXT_PUBLIC_PADDLE_PRICE_STARTER_YEAR=pri_starter_yearly_id

NEXT_PUBLIC_PADDLE_PRICE_PRO_MONTH=pri_pro_monthly_id
NEXT_PUBLIC_PADDLE_PRICE_PRO_YEAR=pri_pro_yearly_id

NEXT_PUBLIC_PADDLE_PRICE_ADVANCED_MONTH=pri_advanced_monthly_id
NEXT_PUBLIC_PADDLE_PRICE_ADVANCED_YEAR=pri_advanced_yearly_id

# Webhook signing secrets from Paddle Developer Tools > Notifications
# Keep these server-side only and never expose them to frontend code
PADDLE_SANDBOX_WEBHOOK_SECRET=pdl_ntf_secret_sandbox_here
PADDLE_LIVE_WEBHOOK_SECRET=pdl_ntf_secret_live_here
PADDLE_WEBHOOK_SECRET=pdl_ntf_secret_general_here
